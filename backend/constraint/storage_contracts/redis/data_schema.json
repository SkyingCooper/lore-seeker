{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-seeker.local/contracts/storage/redis/data_schema.json",
  "title": "Lore Seeker Redis Data Contract",
  "type": "object",
  "definitions": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "is_guest", "created_at"],
      "properties": {
        "user_id": { "type": ["integer", "string"] },
        "is_guest": { "type": "boolean" },
        "fingerprint": { "type": ["string", "null"], "maxLength": 255 },
        "created_at": { "type": "string", "format": "date-time" },
        "last_seen_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "refresh_token": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 32,
          "description": "Current implementation stores the active refresh token string."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_id", "token_hash", "expires_at"],
          "properties": {
            "user_id": { "type": ["integer", "string"] },
            "token_hash": { "type": "string", "minLength": 32 },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "access_token_blacklist": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["1"],
          "description": "Current implementation stores a simple marker."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["jti", "revoked_at"],
          "properties": {
            "jti": { "type": "string", "minLength": 1 },
            "revoked_at": { "type": "string", "format": "date-time" },
            "reason": { "type": ["string", "null"], "maxLength": 255 }
          }
        }
      ]
    },
    "captcha": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["1"],
          "description": "Current implementation stores a simple marker."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["token", "created_at"],
          "properties": {
            "token": { "type": "string", "minLength": 1 },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "task_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "user_id", "status", "started_at", "expected_subtask_count"],
      "properties": {
        "task_id": { "type": ["integer", "string"] },
        "user_id": { "type": ["integer", "string"] },
        "status": { "type": "string", "enum": ["pending", "fetching", "organizing", "completed", "failed"] },
        "current_agent": { "type": ["string", "null"], "enum": [null, "planner", "searcher", "organizer", "retriever"] },
        "started_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" },
        "expected_subtask_count": { "type": "integer", "minimum": 0 },
        "completed_subtask_count": { "type": "integer", "minimum": 0, "default": 0 },
        "plan": { "type": "object", "additionalProperties": true },
        "failure_reason": { "type": ["string", "null"], "maxLength": 4000 }
      }
    },
    "task_subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["subtask_id", "keyword", "status"],
        "properties": {
          "subtask_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "keyword": { "type": "string", "minLength": 1, "maxLength": 240 },
          "source_sites": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string" }
          },
          "status": { "type": "string", "enum": ["pending", "running", "succeeded", "failed", "skipped"] },
          "retry_count": { "type": "integer", "minimum": 0, "maximum": 5 },
          "error_type": { "type": ["string", "null"] }
        }
      }
    },
    "task_results": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["title", "url", "content"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "working_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["timestamp", "agent", "event"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "agent": { "type": "string", "enum": ["planner", "searcher", "organizer", "retriever", "worker", "tool", "mcp"] },
          "event": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "interaction_type": { "type": ["string", "null"], "enum": [null, "agent_handoff", "tool_call", "mcp_call", "state_update", "status_update", "guardrail_decision", "error"] },
          "tool_name": { "type": ["string", "null"], "maxLength": 128 },
          "mcp_server": { "type": ["string", "null"], "maxLength": 128 },
          "status": { "type": ["string", "null"], "enum": [null, "pending", "running", "completed", "failed", "skipped"] },
          "guardrail_decision": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "hook": { "type": "string", "minLength": 1, "maxLength": 80 },
              "allowed": { "type": "boolean" },
              "alert_level": { "type": "string", "enum": ["info", "warning", "critical"] },
              "reason": { "type": ["string", "null"], "maxLength": 2000 },
              "operation": { "type": ["string", "null"], "maxLength": 255 },
              "tool_name": { "type": ["string", "null"], "maxLength": 128 }
            }
          },
          "payload": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "report_version_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "topic_id", "date", "sequence"],
      "properties": {
        "user_id": { "type": ["integer", "string"] },
        "topic_id": { "type": ["integer", "string"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "retriever_session_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "session_id", "turns", "loaded_at"],
      "properties": {
        "user_id": { "type": ["integer", "string"] },
        "session_id": { "type": "string", "minLength": 1 },
        "turns": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["role", "content", "created_at"],
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant", "system", "tool"] },
              "content": { "type": "string", "minLength": 1 },
              "event_type": { "type": ["string", "null"] },
              "emotion_tag": { "type": ["string", "null"] },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "loaded_from_db_count": { "type": "integer", "minimum": 0, "maximum": 5 },
        "loaded_at": { "type": "string", "format": "date-time" },
        "last_turn_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "retriever_semantic_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "items", "loaded_at"],
      "properties": {
        "user_id": { "type": ["integer", "string"] },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["memory_id", "title", "summary", "confidence"],
            "properties": {
              "memory_id": { "type": ["integer", "string"] },
              "title": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "last_accessed": { "type": ["string", "null"], "format": "date-time" }
            }
          }
        },
        "load_rule": {
          "type": "string",
          "const": "confidence >= 0.6 OR last_accessed within 7 days; limit 50; order by confidence desc"
        },
        "loaded_at": { "type": "string", "format": "date-time" }
      }
    },
    "retriever_worklog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["timestamp", "event"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "event": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "intent": { "type": ["string", "null"] },
          "bm25_count": { "type": ["integer", "null"], "minimum": 0 },
          "vector_count": { "type": ["integer", "null"], "minimum": 0 },
          "rrf_count": { "type": ["integer", "null"], "minimum": 0 },
          "rerank_top_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "llm_triggered": { "type": ["boolean", "null"] },
          "payload": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "llm_cache": {
      "type": "string"
    }
  }
}
