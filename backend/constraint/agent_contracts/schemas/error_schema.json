{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-seeker.local/contracts/agent/error_schema.json",
  "title": "Lore Seeker Agent Error Contract",
  "description": "Agent、Tool、Storage 失败时返回给上游的统一错误约束。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "error"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "contract_type": {
      "type": "string",
      "const": "agent.error"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "task_id": {
          "type": ["integer", "string", "null"]
        },
        "session_key": {
          "type": ["string", "null"],
          "maxLength": 255
        },
        "agent": {
          "type": ["string", "null"],
          "enum": [null, "planner", "searcher", "organizer", "retriever", "worker"]
        },
        "tool": {
          "type": ["string", "null"],
          "maxLength": 120
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "category", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": ["validation", "auth", "permission", "rate_limit", "timeout", "provider", "storage", "agent", "unknown"]
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_seconds": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 86400
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        },
        "caused_by": {
          "type": ["string", "null"],
          "maxLength": 2000
        }
      }
    },
    "fallback_action": {
      "type": "string",
      "enum": ["retry", "skip_subtask", "fail_task", "use_cached_result", "ask_planner", "none"]
    }
  }
}
