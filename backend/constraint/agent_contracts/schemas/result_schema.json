{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-seeker.local/contracts/agent/result_schema.json",
  "title": "Lore Seeker Agent Result Contract",
  "description": "Agent 间传递搜索结果、报告结果、RAG 结果和阶段汇总时使用的统一约束。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "task_id", "producer_agent", "status"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "contract_type": {
      "type": "string",
      "const": "agent.result"
    },
    "trace": {
      "$ref": "#/$defs/trace"
    },
    "task_id": {
      "type": ["integer", "string"],
      "minLength": 1
    },
    "producer_agent": {
      "$ref": "#/$defs/agent_name"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "partial", "failed", "skipped"]
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "results": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/search_result"
          }
        },
        "histories": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/search_history"
          }
        },
        "evaluation": {
          "$ref": "#/$defs/search_evaluation"
        }
      }
    },
    "organizer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": ["string", "null"],
          "maxLength": 255
        },
        "content_md": {
          "type": ["string", "null"]
        },
        "toc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toc_item"
          }
        },
        "summary": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "quality_score": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "quality_feedback": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "pass": {
          "type": ["boolean", "null"]
        }
      }
    },
    "retriever": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer": {
          "type": ["string", "null"]
        },
        "sources": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/rag_source"
          }
        }
      }
    },
    "next_action": {
      "type": "string",
      "enum": ["organize", "retry_search", "retry_organize", "archive", "complete", "fail", "none"]
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "agent_name": {
      "type": "string",
      "enum": ["planner", "searcher", "organizer", "retriever", "worker"]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "session_key": {
          "type": ["string", "null"],
          "maxLength": 255
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "search_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "content"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "source_site": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "provider": {
          "type": ["string", "null"],
          "maxLength": 50
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "fetched_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "search_history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtask_id", "keyword", "duration_ms", "retry_count", "result_count", "summary"],
      "properties": {
        "parent_id": {
          "type": ["integer", "string", "null"]
        },
        "subtask_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "keyword": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "source_site": {
          "type": ["string", "null"],
          "maxLength": 500
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "expanded_keywords": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "error_type": {
          "type": ["string", "null"],
          "enum": [null, "timeout", "rate_limited", "http_4xx", "http_5xx", "provider_error", "empty_result", "unknown"]
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "search_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relevance_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_strategy_update": {
          "type": "boolean"
        },
        "strategy_feedback": {
          "type": ["string", "null"],
          "maxLength": 4000
        }
      }
    },
    "toc_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "title", "anchor"],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "rag_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "report_id", "score"],
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "report_id": {
          "type": ["integer", "string"]
        },
        "chunk_id": {
          "type": ["integer", "string", "null"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "duration_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "token_usage": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "model": {
          "type": ["string", "null"],
          "maxLength": 120
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
