{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-seeker.local/contracts/tool/tool_input_schema.json",
  "title": "Lore Seeker Tool Input Contract",
  "description": "Agent 调用 Tool 时使用的统一输入 envelope。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_type", "tool_name", "caller", "input"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "contract_type": {
      "type": "string",
      "const": "tool.input"
    },
    "trace": {
      "$ref": "#/$defs/trace"
    },
    "tool_name": {
      "type": "string",
      "enum": ["search_api", "crawler", "embedding", "reranker", "llm", "redis", "postgres"]
    },
    "caller": {
      "type": "string",
      "enum": ["planner", "searcher", "organizer", "retriever", "worker", "api"]
    },
    "input": {
      "oneOf": [
        { "$ref": "#/$defs/search_api_input" },
        { "$ref": "#/$defs/crawler_input" },
        { "$ref": "#/$defs/embedding_input" },
        { "$ref": "#/$defs/reranker_input" },
        { "$ref": "#/$defs/llm_input" },
        { "$ref": "#/$defs/redis_input" },
        { "$ref": "#/$defs/postgres_input" }
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 60
    },
    "retry": {
      "$ref": "#/$defs/retry"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "task_id": { "type": ["integer", "string", "null"] },
        "subtask_id": { "type": ["string", "null"], "maxLength": 128 },
        "session_key": { "type": ["string", "null"], "maxLength": 255 }
      }
    },
    "source_sites": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "search_api_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "query"],
      "properties": {
        "kind": { "type": "string", "const": "search_api" },
        "query": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source_sites": { "$ref": "#/$defs/source_sites" },
        "provider": { "type": "string", "enum": ["tavily", "serpapi", "bing"] },
        "max_results": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 }
      }
    },
    "crawler_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "urls"],
      "properties": {
        "kind": { "type": "string", "const": "crawler" },
        "urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "wait_until": { "type": "string", "enum": ["domcontentloaded", "load", "networkidle"], "default": "domcontentloaded" },
        "max_chars": { "type": "integer", "minimum": 500, "maximum": 20000, "default": 3000 },
        "user_agent": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "embedding_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "texts"],
      "properties": {
        "kind": { "type": "string", "const": "embedding" },
        "texts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1 }
        },
        "model": { "type": ["string", "null"], "maxLength": 120 },
        "dimension": { "type": "integer", "enum": [1536] }
      }
    },
    "reranker_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "query", "documents"],
      "properties": {
        "kind": { "type": "string", "const": "reranker" },
        "query": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "type": "string", "minLength": 1 }
        },
        "top_n": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 }
      }
    },
    "llm_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "purpose", "messages"],
      "properties": {
        "kind": { "type": "string", "const": "llm" },
        "purpose": { "type": "string", "enum": ["planning", "search_strategy", "organizing", "quality_check", "rag_answer"] },
        "model": { "type": ["string", "null"], "maxLength": 120 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 1 },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string", "enum": ["system", "user", "assistant"] },
              "content": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "redis_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "key"],
      "properties": {
        "kind": { "type": "string", "const": "redis" },
        "operation": { "type": "string", "enum": ["get", "set", "delete", "expire", "append_log"] },
        "key": { "type": "string", "minLength": 1, "maxLength": 300 },
        "value": {},
        "ttl_seconds": { "type": ["integer", "null"], "minimum": 1, "maximum": 2592000 }
      }
    },
    "postgres_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "contract_name"],
      "properties": {
        "kind": { "type": "string", "const": "postgres" },
        "operation": { "type": "string", "enum": ["select", "insert", "update", "delete"] },
        "contract_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "params": { "type": "object", "additionalProperties": true }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "backoff": { "type": "string", "enum": ["none", "fixed", "exponential"], "default": "exponential" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
